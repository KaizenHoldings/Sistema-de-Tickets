# Configuración de Puertos del Host
APP_PORT=8080
DB_PORT=3306
PMA_PORT=8081

# Configuración de Base de Datos
DB_NAME=service_desk_db
DB_USER=root
DB_PASSWORD=root

# Configuración del Superadministrador Inicial
SUPERADMIN_NAME="SuperAdmin Sistema"
SUPERADMIN_EMAIL=superadmin@empresa.com
SUPERADMIN_PASSWORD=password123

# Integración Microsoft Graph & SharePoint
GRAPH_TENANT_ID=tu-tenant.onmicrosoft.com
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=tu-client-secret-aqui
VITE_SHAREPOINT_SITE_ID=tu-tenant.sharepoint.com,site-guid,web-guid
VITE_LIST_NAME="Solicitudes - SSGG e IT"

# Columna de SharePoint que guarda el SOLICITANTE (quien pidio la solicitud).
#
# DEJAR VACIO (configuracion actual y recomendada): el solicitante se guarda
# SOLO en la base local. No se lee ni se escribe nada en SharePoint, y ninguna
# sincronizacion puede alterar ese dato.
#
# ----------------------------------------------------------------------------
# ESTADO EN ESTE PROYECTO (verificado contra la lista de produccion)
#
# La lista "Solicitudes - SSGG e IT" tiene una columna llamada "Solicitante",
# pero es de tipo PERSONA (personOrGroup): no guarda texto, guarda el LookupId
# del usuario del sitio. En un registro real llega asi:
#
#     SolicitanteLookupId = 222      <- solo el ID numerico, no el nombre
#
# Para traducir ese ID a una persona (y al contrario, al escribir) hace falta
# leer los usuarios del sitio, y la aplicacion NO tiene permisos para eso:
#   - Graph (Sites.ReadWrite.All) no expone la User Information List -> itemNotFound
#   - La REST de SharePoint devuelve 401 (el token se emite SIN ningun rol)
#
# Por eso NO pongas aqui "Solicitante". Aunque se pusiera, el sistema detecta
# que es una columna de Persona y deja de sincronizar ese campo para no
# ensuciar ni borrar el dato local, pero la integracion no funcionaria.
#
# PARA HABILITARLA EN EL FUTURO hay dos caminos:
#   a) Crear en la lista una columna de TEXTO (p. ej. "Solicitante (sistema)")
#      y poner aqui su nombre interno. Funciona sin permisos nuevos.
#   b) Conceder a la app el permiso de aplicacion de SharePoint
#      (API permissions > SharePoint > Application > Sites.Read.All, con
#      consentimiento de admin) y usar la columna de Persona existente.
# ----------------------------------------------------------------------------
#
# Descubre el nombre interno y el tipo de cualquier columna con:
#     php bin/list_sharepoint_columns.php solicit
#
# Tipos soportados por el codigo (el tipo se detecta automaticamente):
#   - Texto: se escribe el nombre tal cual.
#   - Persona o grupo: se resuelve el nombre o correo contra los usuarios del
#     sitio y se escribe su LookupId. Requiere el permiso del punto (b).
SHAREPOINT_FIELD_REQUESTED_BY=

# Modo seguro: con "true" ninguna operacion de escritura llega a SharePoint.
# Util para probar el mapeo antes de tocar la lista de produccion.
SHAREPOINT_DRY_RUN=false

